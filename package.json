{
  "name": "weplace-public-site",
  "private": true,
  "version": "1.1.0",
  "description": "Static public site; FLOW authentication and storage stay on the existing service.",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "test": "node --test tests/*.test.cjs",
    "check:links": "python3 scripts/check-links.py",
    "verify": "npm test && npm run check:links && npm run build",
    "test:r43": "playwright test --config playwright.r43.config.cjs",
    "test:r44": "playwright test --config playwright.r44.config.cjs",
    "test:r45": "playwright test --config playwright.r45.config.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "axe-core": "^4.14.0",
    "jsdom": "26.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
